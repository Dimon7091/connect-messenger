{
  "name": "@messenger/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts"
  },
  "scripts": {
    "format": "prettier --write \"src/**/*.{ts,json}\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:migrate:prod": "drizzle-kit migrate",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "dotenv": "^18.0.7",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "prettier": "catalog:",
    "tsx": "^4.23.15",
    "typescript": "catalog:"
  }
}
