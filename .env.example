// Environment
NODE_ENV=
GLOBAL_DOMAIN=localhost

// Database
DB_HOST=localhost
DB_USER=
DB_PORT=
DB_NAME=
DB_PASSWORD=
DB_URL="postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public"

// Api
API_PORT=
JWT_SECRET=

// Web
VITE_API_BASE_URL=http://${GLOBAL_DOMAIN}:${API_PORT}/api/v1