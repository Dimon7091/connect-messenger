{
  "name": "connect-messenger",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "api:dev": "pnpm -F @messenger/api dev",
    "api:test": "pnpm -F @messenger/api vitest run",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "format:all": "prettier --write \"**/*.{ts,tsx,vue,css,scss,md,json,yml,yaml}\" --ignore-path .gitignore",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "catalog:",
    "turbo": "^2.11.10"
  },
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  }
}
