{
  "name": "connect-messenger",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "api:dev": "pnpm -F @messenger/api dev",
    "api:test": "pnpm -F @messenger/api test",
    "api:test:watch": "pnpm -F @messenger/api test:watch",
    "api:test:coverage": "pnpm -F @messenger/api test:coverage",
    "db:generate": "pnpm -F @messenger/database db:generate",
    "db:migrate": "pnpm -F @messenger/database tsx src/migrate.ts",
    "db:migrate:prod": "pnpm -F @messenger/database drizzle-kit migrate",
    "db:push": "pnpm -F @messenger/database drizzle-kit push",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "format:all": "prettier --write \"**/*.{ts,tsx,vue,css,scss,md,json,yml,yaml}\" --ignore-path .gitignore",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "catalog:",
    "turbo": "^2.11.10"
  },
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  }
}
